        "/scraper/rental-estate": {
            "post": {
                "description": "Scrapping Manualy by Target URL",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Scraper Controls"
                ],
                "summary": "Trigger Scraper Job",
                "parameters": [
                    {
                        "description": "Target URL Payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.triggerScraperRentalEstateRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Scraper job started successfully",
                        "schema": {
                            "$ref": "#/definitions/handler.apiResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
