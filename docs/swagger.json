        "/rag/multi/upload": {
            "post": {
                "description": "Uploads a PDF or Image file using streaming gRPC underneath",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RAG"
                ],
                "summary": "Upload file (PDF/Image) to Multi-Tenant RAG",
                "parameters": [
                    {
                        "description": "Upload Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.UploadFileMultiTenantReqDTO"
                        }
                    },
                    {
                        "type": "file",
                        "description": "File to upload (PDF, PNG, JPG, WEBP)",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.UploadFileMultiTenantResDTO"
                        }
                    },
                    "400": {
                        "description": "Invalid payload or file type",
                        "schema": {
                            "$ref": "#/definitions/handler.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/handler.errorResponse"
                        }
                    }
                }
            }
        },
